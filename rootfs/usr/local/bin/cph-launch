#!/usr/bin/env bash
# Start the CrashPlan service JVM directly, replacing bin/CrashPlanService.
#
# The stock launcher only lets -Xmx through (conf/jvm_args) and blanks
# JAVA_TOOL_OPTIONS. This script passes the same base arguments (captured
# from app.log of 12.1.1, "JavaOptions") and adds memory-release, diagnostic
# and agent options on top.
set -euo pipefail

CP_DIR=/usr/local/crashplan
JAVA="$CP_DIR/jre/bin/java"
NLIB="$CP_DIR/nlib"
DIAG_DIR="${CPH_DIAG_DIR:-/config/diag}"

log() { echo "[cph-launch] $*" >&2; }
is_true() { case "${1,,}" in 1|true|yes|on) return 0 ;; *) return 1 ;; esac; }

# --- heap size -------------------------------------------------------------
# CRASHPLAN_SRV_MAX_MEM uses the usual CrashPlan image semantics (e.g. 40G).
# The start never fails on a heap value: an unusable one is reported and the
# next source is used (saved conf/jvm_args, then 1024M).
# Prints MiB for a size from 1024M to 4096G; anything else returns 1.
heap_mb() {
    local v="$1" num unit mb
    [[ "$v" =~ ^0*([1-9][0-9]{0,8})([gGmMkK])$ ]] || return 1
    num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2],,}"
    case "$unit" in
        g) mb=$((num * 1024)) ;;
        m) mb="$num" ;;
        k) mb=$((num / 1024)) ;;
    esac
    (( mb >= 1024 && mb <= 4194304 )) || return 1
    echo "$mb"
}

SAVED_HEAP="$CP_DIR/conf/jvm_args"
XMX_MB=""
if [[ -n "${CRASHPLAN_SRV_MAX_MEM:-}" ]]; then
    XMX_MB="$(heap_mb "$CRASHPLAN_SRV_MAX_MEM")" ||
        log "WARNING: CRASHPLAN_SRV_MAX_MEM is not a size from 1024M to 4096G (e.g. 40G); ignored"
fi
if [[ -z "$XMX_MB" && -r "$SAVED_HEAP" ]]; then
    # The first -Xmx<size> token anywhere in the file; comments are skipped.
    saved="$(grep -v '^[[:space:]]*#' "$SAVED_HEAP" | grep -oE '(^|[[:space:]])-Xmx[0-9]+[gGmMkK]([[:space:]]|$)' | head -1 | tr -d '[:space:]' || true)"
    if [[ -n "$saved" ]]; then
        XMX_MB="$(heap_mb "${saved#-Xmx}")" ||
            { XMX_MB=""; log "WARNING: conf/jvm_args heap is outside 1024M to 4096G; using 1024M"; }
    elif grep -q -- '-Xmx' "$SAVED_HEAP"; then
        log "WARNING: conf/jvm_args has no usable -Xmx value; using 1024M"
    fi
fi
XMX_MB="${XMX_MB:-1024}"

# --- base arguments (identical to the stock launcher) -----------------------
# Keep the stock launcher's user.install property. On Linux, the matching
# SystemProperties.isRootInstall implementation instead checks whether the
# working directory is outside user.home. Running in CP_DIR therefore keeps
# the root-install restore-helper contract; this property does not waive it.
USER_INSTALL="${CPH_USER_INSTALL:-1}"

args=(
    -Dsun.jnu.encoding=UTF-8
    -Dfile.encoding=UTF-8
    -Dsun.net.inetaddr.ttl=300
    -Dnetworkaddress.cache.ttl=300
    -Dsun.net.inetaddr.negative.ttl=0
    -Dnetworkaddress.cache.negative.ttl=0
    -Dapp=CrashPlanService
    -DappBaseName=CrashPlan
    -Djna.nosys=true
    -Djava.awt.headless=true
    -DCrashPlan=CrashPlan
    -Dnashorn.args=--no-deprecation-warning
    -XX:+UseCompactObjectHeaders
    -XX:-ShrinkHeapInSteps
    -XX:MaxHeapFreeRatio="${CPH_MAX_HEAP_FREE_RATIO:-30}"
    -XX:MinHeapFreeRatio="${CPH_MIN_HEAP_FREE_RATIO:-15}"
    --add-exports=java.base/sun.security.jca=ALL-UNNAMED
    --add-exports=java.base/sun.security.x509=ALL-UNNAMED
    --add-exports=java.base/sun.security.util=ALL-UNNAMED
    --add-exports=java.base/sun.security.provider=ALL-UNNAMED
    --add-opens=java.base/java.security=ALL-UNNAMED
    --add-opens=java.base/java.io=ALL-UNNAMED
    --add-opens=java.base/java.util=ALL-UNNAMED
    --add-opens=java.base/java.lang=ALL-UNNAMED
    -Djava.library.path="$NLIB"
    -Djna.library.path="$NLIB"
    --enable-native-access=ALL-UNNAMED
    -Dc42.log.config="$CP_DIR/conf/service.log.xml"
    -Duser.install="$USER_INSTALL"
    -Xmx"${XMX_MB}m"
    -Djava.class.path=lib/cpg-agent-service.jar:lang
)

# --- compressed object references ---------------------------------------------
# Above 32736 MiB the JVM drops compressed references, so a 40G heap holds
# about what a 31G one does. Up to about 64 GiB, 16-byte object alignment
# keeps them (measured on the bundled JRE: 28.7% -> 5.9% overhead on a
# file-metadata graph). CPH_WIDE_OOPS=1 keeps the JVM default. ZGC never uses
# compressed references, so the flag would only cost memory there.
if (( XMX_MB > 32736 && XMX_MB <= 65000 )) && ! is_true "${CPH_WIDE_OOPS:-0}" && [[ "${CPH_GC:-g1}" != zgc ]]; then
    args+=(-XX:ObjectAlignmentInBytes=16)
    OOPS="compressed-16"
elif (( XMX_MB > 32736 )); then
    OOPS="wide"
else
    OOPS="compressed"
fi

# --- out of memory -----------------------------------------------------------
# A Java OutOfMemoryError can kill backup threads while the service still
# answers status requests. Exit instead: cphd reports ENGINE_EXITED and the
# container restart policy starts a fresh engine.
args+=(-XX:+ExitOnOutOfMemoryError)

# The heap is not the whole process: metaspace, threads, LevelDB/SQLite and
# direct buffers live outside it. Warn when the container limit leaves less
# than 2 GiB for them, because the kernel then kills the engine mid-write.
limit="$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)"
if [[ "$limit" =~ ^[0-9]+$ ]] && (( XMX_MB + 2048 > limit / 1048576 )); then
    log "WARNING: heap ${XMX_MB}m leaves under 2 GiB for native memory below the container memory limit of $(( limit / 1048576 ))m; lower CRASHPLAN_SRV_MAX_MEM or raise the limit"
fi

# --- garbage collector: give memory back to the host -------------------------
case "${CPH_GC:-g1}" in
    g1)
        # A periodic concurrent cycle when idle lets G1 shrink and uncommit
        # the heap after the big verification scan instead of holding it.
        # Every 15 minutes: with a live heap of many GB each cycle costs CPU.
        args+=(-XX:+UseG1GC -XX:G1PeriodicGCInterval="${CPH_G1_PERIODIC_GC_MS:-900000}")
        ;;
    shenandoah)
        args+=(-XX:+UseShenandoahGC -XX:ShenandoahUncommitDelay="${CPH_UNCOMMIT_DELAY_MS:-300000}")
        ;;
    zgc)
        args+=(-XX:+UseZGC -XX:ZUncommitDelay="$(( ${CPH_UNCOMMIT_DELAY_MS:-300000} / 1000 ))")
        ;;
    *)
        log "ERROR: CPH_GC must be g1, shenandoah or zgc (got '${CPH_GC}')"
        exit 1
        ;;
esac

# Return freed malloc memory (LevelDB, SQLite, NSS, JNA) to the OS.
if [[ "${CPH_TRIM_NATIVE_MS:-60000}" != 0 ]]; then
    args+=(-XX:TrimNativeHeapInterval="${CPH_TRIM_NATIVE_MS:-60000}")
fi
export MALLOC_ARENA_MAX="${CPH_MALLOC_ARENA_MAX:-2}"

# --- diagnostics -------------------------------------------------------------
mkdir -p "$DIAG_DIR"
if is_true "${CPH_DIAGNOSTICS:-0}"; then
    # NMT summary costs a few percent; attach allows jcmd from a sidecar.
    args+=(-XX:NativeMemoryTracking=summary)
else
    args+=(-XX:+DisableAttachMechanism)
fi
if is_true "${CPH_JFR:-0}"; then
    # shellcheck disable=SC2054 # commas belong to the JFR option value
    args+=(-XX:StartFlightRecording=disk=true,maxsize=512m,maxage=24h,dumponexit=true,filename="$DIAG_DIR/")
fi
if is_true "${CPH_HEAPDUMP_ON_OOM:-0}"; then
    # A dump is as large as the used heap. Check free space on /config first.
    args+=(-XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath="$DIAG_DIR")
fi

# --- agent -------------------------------------------------------------------
# The agent also enforces every restore helper IPC request.
# A non-root engine has no home in the image. The daemon passes HOME and USER;
# /config/.crashplan is the same directory root reaches through /root.
if [[ "$(id -u)" != 0 ]]; then
    args+=(-Duser.home="${HOME:-/config}" -Duser.name="${USER:-crashplan}")
fi
args+=(-javaagent:"$CP_DIR/cph/cph-agent.jar")

# --- extra options, last so they can override everything above ---------------
if [[ -n "${CPH_EXTRA_JAVA_OPTS:-}" ]]; then
    read -r -a extra <<<"$CPH_EXTRA_JAVA_OPTS"
    args+=("${extra[@]}")
fi

unset JAVA_TOOL_OPTIONS _JAVA_OPTIONS JDK_JAVA_OPTIONS
export LD_LIBRARY_PATH="$NLIB"
export LD_PRELOAD="$NLIB/libwrapper.so"

cd "$CP_DIR"
log "heap=${XMX_MB}m oops=${OOPS} gc=${CPH_GC:-g1} diagnostics=${CPH_DIAGNOSTICS:-0} patches=${CPH_PATCHES:-none}"
exec "$JAVA" "${args[@]}" com.backup42.service.CPService
